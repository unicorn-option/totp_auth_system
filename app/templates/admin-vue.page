<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>管理后台</title>
    <!-- 引入共用 JavaScript 文件 -->
    <script src="/static/js/common.js"></script>
    <!-- 引入 Vue.js -->
    <script src="https://cdn.jsdelivr.net/npm/vue@2.6.14/dist/vue.js"></script>
    <!-- 引入 QR Code 生成库 -->
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <!-- 引入静态样式文件 -->
    <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body>
    {% include "navbar-vue.html" %}
    <div class="content" id="app">
        <h1>Admin Panel</h1>
        <p>Welcome, Admin!</p>
        
        <h2>User Management</h2>
        
        {%raw%}
        <!-- Create User Button -->
        <div class="create-user-btn">
            <button type="button" class="create-btn" @click="showCreateForm = true">Create User</button>
        </div>
        
        <!-- Create User Modal (Hidden by default) -->
        <div id="createUserModal" class="modal" v-if="showCreateForm" style="display: block;">
            <div class="modal-content">
                <span class="close" @click="showCreateForm = false">&times;</span>
                <h3>Create New User</h3>
                <form @submit.prevent="createUser">
                    <div class="form-group">
                        <label for="username">Username:</label>
                        <input type="text" id="username" v-model="newUser.username" required>
                    </div>
                    <button type="submit" class="create-btn" :disabled="loading">Submit</button>
                    <button type="button" class="cancel-btn" @click="showCreateForm = false">Cancel</button>
                </form>
            </div>
        </div>
        
        <!-- QR Code Result (Hidden by default) -->
        <div class="qr-result" v-if="showQrCode">
            <h3>QR Code</h3>
            <div id="qrCodeImage">
                <img :src="qrCodeUrl" alt="QR Code" v-if="qrCodeUrl">
            </div>
            <button type="button" class="ok-btn" @click="hideQrCode">OK</button>
        </div>
        
        <!-- Loading State -->
        <div class="loading" v-if="loading">
            <p>Loading...</p>
        </div>
        
        <!-- User Table -->
        <div class="user-table">
            <table border="1" cellpadding="10" cellspacing="0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="user in users" :key="user.id">
                        <td>{{ user.id }}</td>
                        <td>{{ user.username }}</td>
                        <td>{{ user.role }}</td>
                        <td>{{ user.is_active }}</td>
                        <td>
                            <button 
                                type="button" 
                                class="delete-btn" 
                                :class="{ 'confirm-delete': confirmDeleteId === user.id }"
                                @click="toggleDelete(user.id)"
                            >
                                {{ confirmDeleteId === user.id ? '确认删除' : '删除' }}
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="pagination" style="margin-top: '20px'; text-align: 'center';">
            <button 
                @click="page > 1 && (page--, fetchUsers())"
                :disabled="page === 1 || loading"
                style="margin: '0 5px'; padding: '5px 10px';"
            >
                Previous
            </button>
            <span>
                Page {{ page }} of {{ pages }}
            </span>
            <button 
                @click="page < pages && (page++, fetchUsers())"
                :disabled="page === pages || loading"
                style="margin: '0 5px'; padding: '5px 10px';"
            >
                Next
            </button>
            <select 
                v-model="limit"
                @change="fetchUsers()"
                style="margin-left: '20px'; padding: '5px';"
            >
                <option value="10">10 per page</option>
                <option value="20">20 per page</option>
                <option value="50">50 per page</option>
            </select>
        </div>
        {%endraw%}
        
        <script>
            new Vue({
                el: '#app',
                data: {
                    users: [],
                    newUser: {
                        username: ''
                    },
                    showCreateForm: false,
                    showQrCode: false,
                    qrCodeUrl: '',
                    loading: false,
                    confirmDeleteId: null,
                    page: 1,
                    limit: 10,
                    total: 0,
                    pages: 1
                },
                mounted() {
                    // 初始化时获取用户列表
                    this.fetchUsers();
                },
                methods: {
                    async fetchUsers() {
                        this.loading = true;
                        try {
                            // 调用 API 获取用户列表
                            const data = await ApiUtils.fetchUsers(this.page, this.limit);
                            this.users = data.users;
                            this.total = data.total;
                            this.pages = data.pages;
                        } catch (error) {
                            console.error('Failed to fetch users:', error);
                        } finally {
                            this.loading = false;
                        }
                    },
                    async createUser() {
                        this.loading = true;
                        
                        try {
                            // 创建用户
                            const data = await ApiUtils.createUser(this.newUser.username);
                            
                            // 隐藏创建表单
                            this.showCreateForm = false;
                            this.newUser.username = '';
                            
                            // 生成 QR Code
                            this.qrCodeUrl = await ApiUtils.generateQRCode(data.uri);
                            this.showQrCode = true;
                        } catch (error) {
                            console.error('Error:', error);
                            alert('Failed to create user');
                        } finally {
                            this.loading = false;
                        }
                    },
                    hideQrCode() {
                        this.showQrCode = false;
                        this.qrCodeUrl = '';
                        // 刷新用户列表
                        this.fetchUsers();
                    },
                    async toggleDelete(userId) {
                        if (this.confirmDeleteId === userId) {
                            // 确认删除
                            this.loading = true;
                            try {
                                await ApiUtils.deleteUser(userId);
                                // 刷新用户列表
                                this.fetchUsers();
                                this.confirmDeleteId = null;
                            } catch (error) {
                                console.error('Error:', error);
                                alert('Failed to delete user');
                            } finally {
                                this.loading = false;
                            }
                        } else {
                            // 第一次点击，显示确认
                            this.confirmDeleteId = userId;
                        }
                    }
                }
            });
        </script>
    </div>
</body>
</html>