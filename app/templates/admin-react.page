<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>管理后台</title>
    <!-- 引入共用 JavaScript 文件 -->
    <script src="/static/js/common.js"></script>
    <!-- 引入 React -->
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <!-- 引入 Babel -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- 引入 QR Code 生成库 -->
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <!-- 引入静态样式文件 -->
    <link rel="stylesheet" href="/static/css/styles.css">
    <style>
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 999;
            background-color: transparent;
        }
        .delete-btn {
            background-color: orange;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
        }
        .delete-btn.confirm-delete {
            background-color: red;
        }
    </style>
</head>
<body>
    {% include "navbar-react.html" %}
    <div id="root"></div>
    
    {%raw%}
    <script type="text/babel">
        const { useState, useEffect } = React;
        const { createRoot } = ReactDOM;
        
        function AdminPage() {
            const [users, setUsers] = useState([]);
            const [showCreateForm, setShowCreateForm] = useState(false);
            const [newUsername, setNewUsername] = useState('');
            const [showQrCode, setShowQrCode] = useState(false);
            const [qrCodeUrl, setQrCodeUrl] = useState('');
            const [loading, setLoading] = useState(false);
            const [confirmDeleteId, setConfirmDeleteId] = useState(null);
            const [page, setPage] = useState(1);
            const [limit, setLimit] = useState(10);
            const [total, setTotal] = useState(0);
            const [pages, setPages] = useState(1);
            
            // 初始化时获取用户列表
            useEffect(() => {
                fetchUsers();
            }, [page, limit]);
            
            const fetchUsers = async () => {
                setLoading(true);
                try {
                    // 调用 API 获取用户列表
                    const data = await ApiUtils.fetchUsers(page, limit);
                    setUsers(data.users);
                    setTotal(data.total);
                    setPages(data.pages);
                } catch (err) {
                    console.error('Failed to fetch users:', err);
                } finally {
                    setLoading(false);
                }
            };
            
            const createUser = async (e) => {
                e.preventDefault();
                setLoading(true);
                
                try {
                    // 创建用户
                    const data = await ApiUtils.createUser(newUsername);
                    
                    // 生成 QR Code
                    const qrUrl = await ApiUtils.generateQRCode(data.uri);
                    
                    setQrCodeUrl(qrUrl);
                    setShowQrCode(true);
                    setShowCreateForm(false);
                    setNewUsername('');
                    fetchUsers(); // 刷新用户列表
                } catch (err) {
                    console.error('Failed to create user:', err);
                } finally {
                    setLoading(false);
                }
            };
            
            const toggleDelete = async (userId) => {
                if (confirmDeleteId === userId) {
                    // 确认删除
                    setLoading(true);
                    try {
                        await ApiUtils.deleteUser(userId);
                        fetchUsers(); // 刷新用户列表
                        setConfirmDeleteId(null);
                    } catch (err) {
                        console.error('Failed to delete user:', err);
                    } finally {
                        setLoading(false);
                    }
                } else if (!confirmDeleteId) {
                    // 第一次点击，显示确认
                    setConfirmDeleteId(userId);
                }
            };
            
            const cancelDelete = () => {
                setConfirmDeleteId(null);
            };

            
            return (
                <div className="content">
                    <h1>Admin Panel</h1>
                    <p>Welcome, Admin!</p>
                    
                    <h2>User Management</h2>
                    
                    {/* Create User Button */}
                    <div className="create-user-btn">
                        <button 
                            type="button" 
                            className="create-btn" 
                            onClick={() => setShowCreateForm(true)}
                            disabled={loading}
                        >
                            Create User
                        </button>
                    </div>
                    
                    {/* Create User Modal (Hidden by default) */}
                    {showCreateForm && (
                        <div className="modal" style={{ display: 'block' }}>
                            <div className="modal-content">
                                <span className="close" onClick={() => setShowCreateForm(false)}>&times;</span>
                                <h3>Create New User</h3>
                                <form onSubmit={createUser}>
                                    <div className="form-group">
                                        <label htmlFor="username">Username:</label>
                                        <input 
                                            type="text" 
                                            id="username" 
                                            value={newUsername}
                                            onChange={(e) => setNewUsername(e.target.value)}
                                            required
                                        />
                                    </div>
                                    <button 
                                        type="submit" 
                                        className="create-btn"
                                        disabled={loading}
                                    >
                                        Submit
                                    </button>
                                    <button 
                                        type="button" 
                                        className="cancel-btn" 
                                        onClick={() => setShowCreateForm(false)}
                                    >
                                        Cancel
                                    </button>
                                </form>
                            </div>
                        </div>
                    )}
                    
                    {/* QR Code Result (Hidden by default) */}
                    {showQrCode && (
                        <div className="qr-result">
                            <h3>QR Code</h3>
                            <div id="qrCodeImage">
                                {qrCodeUrl && <img src={qrCodeUrl} alt="QR Code" />}
                            </div>
                            <button 
                                type="button" 
                                className="ok-btn" 
                                onClick={() => setShowQrCode(false)}
                            >
                                OK
                            </button>
                        </div>
                    )}
                    
                    {/* Loading State */}
                    {loading && (
                        <div className="loading">
                            <p>Loading...</p>
                        </div>
                    )}
                    
                    {/* User Table */}
                    <div className="user-table">
                        <table border="1" cellpadding="10" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Username</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {users.map(user => (
                                    <tr key={user.id}>
                                        <td>{user.id}</td>
                                        <td>{user.username}</td>
                                        <td>{user.role}</td>
                                        <td>{user.is_active}</td>
                                        <td>
                                            <button 
                                                type="button" 
                                                className={`delete-btn ${confirmDeleteId === user.id ? 'confirm-delete' : ''}`}
                                                onClick={() => toggleDelete(user.id)}
                                            >
                                                {confirmDeleteId === user.id ? '确认删除' : '删除'}
                                            </button>
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                    
                    {/* 点击空白处取消确认状态 */}
                    {confirmDeleteId && (
                        <div className="overlay" onClick={cancelDelete}></div>
                    )}
                    
                    {/* Pagination */}
                    <div className="pagination" style={{ marginTop: '20px', textAlign: 'center' }}>
                        <button 
                            onClick={() => setPage(Math.max(1, page - 1))}
                            disabled={page === 1 || loading}
                            style={{ margin: '0 5px', padding: '5px 10px' }}
                        >
                            Previous
                        </button>
                        <span>
                            Page {page} of {pages}
                        </span>
                        <button 
                            onClick={() => setPage(Math.min(pages, page + 1))}
                            disabled={page === pages || loading}
                            style={{ margin: '0 5px', padding: '5px 10px' }}
                        >
                            Next
                        </button>
                        <select 
                            value={limit}
                            onChange={(e) => setLimit(Number(e.target.value))}
                            style={{ marginLeft: '20px', padding: '5px' }}
                        >
                            <option value={10}>10 per page</option>
                            <option value={20}>20 per page</option>
                            <option value={50}>50 per page</option>
                        </select>
                    </div>
                </div>
            );
        }
        
        createRoot(document.getElementById('root')).render(<AdminPage />);
    </script>
    {%endraw%}
</body>
</html>