<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>登录 - TOTP Auth System</title>
    <!-- 引入 React -->
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <!-- 引入 Babel -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- 引入共用 JavaScript 文件 -->
    <script src="/static/js/common.js"></script>
    <!-- 引入静态样式文件 -->
    <link rel="stylesheet" href="/static/css/styles.css">
    <style>
        body {
            background-color: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
    </style>
</head>
<body>
    <div id="root"></div>
    
    {%raw%}
    <script type="text/babel">
        const { useState } = React;
        const { createRoot } = ReactDOM;
        
        function LoginPage() {
            const [username, setUsername] = useState('');
            const [totpCode, setTotpCode] = useState('');
            const [loading, setLoading] = useState(false);
            const [error, setError] = useState('');
            
            const handleSubmit = async (e) => {
                e.preventDefault();
                setLoading(true);
                setError('');
                
                try {
                    const result = await ApiUtils.login(username, totpCode);
                    
                    // 根据用户角色重定向
                    window.location.href = result.redirectUrl;
                } catch (err) {
                    setError(err.message || 'Login failed');
                } finally {
                    setLoading(false);
                }
            };
            
            return (
                <div className="login-container">
                    <h1>TOTP Auth System</h1>
                    <form onSubmit={handleSubmit}>
                        <div className="form-group">
                            <label htmlFor="username">账号</label>
                            <input
                                type="text"
                                id="username"
                                value={username}
                                onChange={(e) => setUsername(e.target.value)}
                                required
                            />
                        </div>
                        <div className="form-group">
                            <label htmlFor="totp_code">动态密码</label>
                            <input
                                type="text"
                                id="totp_code"
                                value={totpCode}
                                onChange={(e) => setTotpCode(e.target.value)}
                                required
                                maxLength={6}
                                pattern="[0-9]{6}"
                            />
                        </div>
                        <button type="submit" disabled={loading}>
                            {loading ? '登录中...' : '登录'}
                        </button>
                    </form>
                    {error && <div className="error-message">{error}</div>}
                    {loading && <div className="loading">登录中...</div>}
                </div>
            );
        }
        
        createRoot(document.getElementById('root')).render(<LoginPage />);
    </script>
    {%endraw%}
</body>
</html>