<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>用户中心</title>
    <!-- 引入共用 JavaScript 文件 -->
    <script src="/static/js/common.js"></script>
    <!-- 引入 Vue.js -->
    <script src="https://cdn.jsdelivr.net/npm/vue@2.6.14/dist/vue.js"></script>
    <!-- 引入 QR Code 生成库 -->
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <!-- 引入静态样式文件 -->
    <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body>
    {% include "navbar-vue.html" %}
    <div class="content" id="app">
        <h1>User Center</h1>
        <p>Welcome to User Center!</p>
        
        {%raw%}
        <h2>TOTP Management</h2>
        
        <form @submit.prevent="rotateTotp">
            <button type="submit" class="rotate-btn" :disabled="loading">Rotate TOTP Secret</button>
        </form>
        
        <form @submit.prevent="generateQrCode">
            <button type="submit" class="qr-btn" :disabled="loading">Generate QR Code</button>
        </form>
        
        <!-- QR Code Result -->
        <div class="qr-result" v-if="showQrCode">
            <h3>QR Code</h3>
            <div>
                <img :src="qrCodeUrl" alt="QR Code" v-if="qrCodeUrl">
            </div>
            <button type="button" class="ok-btn" @click="hideQrCode">OK</button>
        </div>
        
        <!-- Loading State -->
        <div class="loading" v-if="loading">
            <p>Loading...</p>
        </div>
        
        <!-- Error Message -->
        <div class="error-message" v-if="error">
            {{ error }}
        </div>
        {%endraw%}
        
        <script>
            new Vue({
                el: '#app',
                data: {
                    showQrCode: false,
                    qrCodeUrl: '',
                    loading: false,
                    error: ''
                },
                methods: {
                    async rotateTotp() {
                        this.loading = true;
                        this.error = '';
                        
                        try {
                            // 旋转 TOTP 密钥
                            const data = await ApiUtils.rotateTotp();
                            
                            // 生成 QR Code
                            this.qrCodeUrl = await ApiUtils.generateQRCode(data.uri);
                            this.showQrCode = true;
                        } catch (error) {
                            this.error = error.message;
                        } finally {
                            this.loading = false;
                        }
                    },
                    async generateQrCode() {
                        this.loading = true;
                        this.error = '';
                        
                        try {
                            // 获取 TOTP URI
                            const data = await ApiUtils.generateTotpQrCode();
                            
                            // 生成 QR Code
                            this.qrCodeUrl = await ApiUtils.generateQRCode(data.uri);
                            this.showQrCode = true;
                        } catch (error) {
                            this.error = error.message;
                        } finally {
                            this.loading = false;
                        }
                    },
                    hideQrCode() {
                        this.showQrCode = false;
                        this.qrCodeUrl = '';
                    }
                }
            });
        </script>
    </div>
</body>
</html>