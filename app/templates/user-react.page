<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>用户中心</title>
    <!-- 引入共用 JavaScript 文件 -->
    <script src="/static/js/common.js"></script>
    <!-- 引入 React -->
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <!-- 引入 Babel -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- 引入 QR Code 生成库 -->
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
    <!-- 引入静态样式文件 -->
    <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body>
    {% include "navbar-react.html" %}
    <div id="root"></div>
    
    {%raw%}
    <script type="text/babel">
        const { useState } = React;
        const { createRoot } = ReactDOM;
        
        function UserPage() {
            const [showQrCode, setShowQrCode] = useState(false);
            const [qrCodeUrl, setQrCodeUrl] = useState('');
            const [loading, setLoading] = useState(false);
            const [error, setError] = useState('');
            
            const rotateTotp = async (e) => {
                e.preventDefault();
                setLoading(true);
                setError('');
                
                try {
                    // 旋转 TOTP 密钥
                    const data = await ApiUtils.rotateTotp();
                    
                    // 生成 QR Code
                    const qrUrl = await ApiUtils.generateQRCode(data.uri);
                    setQrCodeUrl(qrUrl);
                    setShowQrCode(true);
                } catch (err) {
                    setError(err.message);
                } finally {
                    setLoading(false);
                }
            };
            
            const generateQrCode = async (e) => {
                e.preventDefault();
                setLoading(true);
                setError('');
                
                try {
                    // 获取 TOTP URI
                    const data = await ApiUtils.generateTotpQrCode();
                    
                    // 生成 QR Code
                    const qrUrl = await ApiUtils.generateQRCode(data.uri);
                    setQrCodeUrl(qrUrl);
                    setShowQrCode(true);
                } catch (err) {
                    setError(err.message);
                } finally {
                    setLoading(false);
                }
            };
            

            
            return (
                <div className="content">
                    <h1>User Center</h1>
                    <p>Welcome to User Center!</p>
                    
                    <h2>TOTP Management</h2>
                    
                    <form onSubmit={rotateTotp}>
                        <button 
                            type="submit" 
                            className="rotate-btn"
                            disabled={loading}
                        >
                            Rotate TOTP Secret
                        </button>
                    </form>
                    
                    <form onSubmit={generateQrCode}>
                        <button 
                            type="submit" 
                            className="qr-btn"
                            disabled={loading}
                        >
                            Generate QR Code
                        </button>
                    </form>
                    
                    {/* QR Code Result */}
                    {showQrCode && (
                        <div className="qr-result">
                            <h3>QR Code</h3>
                            <div>
                                {qrCodeUrl && <img src={qrCodeUrl} alt="QR Code" />}
                            </div>
                            <button 
                                type="button" 
                                className="ok-btn"
                                onClick={() => setShowQrCode(false)}
                            >
                                OK
                            </button>
                        </div>
                    )}
                    
                    {/* Loading State */}
                    {loading && (
                        <div className="loading">
                            <p>Loading...</p>
                        </div>
                    )}
                    
                    {/* Error Message */}
                    {error && (
                        <div className="error-message">
                            {error}
                        </div>
                    )}
                </div>
            );
        }
        
        createRoot(document.getElementById('root')).render(<UserPage />);
    </script>
    {%endraw%}
</body>
</html>